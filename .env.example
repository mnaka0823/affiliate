# コピーして .env にし、キーを書く。.env は git に入れない。
OPENAI_API_KEY=
# 任意：モデルIDを上書き（`python3 scripts/image.py models` で確認）
# OPENAI_IMAGE_MODEL=gpt-image-2.6-sunburst
# 任意：保存先を上書き（相対パスはプロジェクトのルートから）
# OPENAI_IMAGE_OUTPUT_DIR=images/output
# 任意：API の URL を上書き（プロキシやテスト用）
# OPENAI_BASE_URL=https://api.openai.com/v1
